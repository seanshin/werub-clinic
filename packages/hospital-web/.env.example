# WeRU.B Hospital Web (clinic.example.org, :3600) — 설치 env 예시
# ⚠️ 자체 API/DB 없음. /api/* · /uploads/* 를 메인앱으로 프록시 → MAIN_APP_URL 필수.
#    (HIS 연동 데이터도 메인앱 api/clinic/his/* 경유)
# 사용법: cp .env.example .env 후 값 채우기.

# [필수] 메인앱 API/uploads 프록시 대상.
MAIN_APP_URL=http://localhost:3000

# [권장] 메인앱 공개 URL (링크·브랜딩·이미지 도메인)
NEXT_PUBLIC_MAIN_URL=https://example.org

# [권장] 메인앱 공개 URL — auth-ui 소셜 로그인 시작/기본 링크 대상 (미설정 시 https://example.org)
NEXT_PUBLIC_MAIN_APP_URL=https://example.org

# [필수-빌드] Cloudflare Turnstile 사이트 키 (봇 방지). 빌드 시 필요.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# [실행] 서비스 포트
PORT=3600
